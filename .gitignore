# 1. Ignore everything under extern/ (eigen-3.4.0, libigl, stb -- plain clones made
#    by bootstrap_env.ps1's Confirm-ExternDep, not committed in this repo)
/extern/*

# 2. But do not ignore the OpenABF folder itself (it IS committed directly, not a
#    submodule/clone -- see bootstrap_env.ps1's comment on this)
!/extern/OpenABF/

# 3. Now ignore everything inside OpenABF again
/extern/OpenABF/*

# 4. Finally, unignore include/ and everything beneath it
!/extern/OpenABF/include/
!/extern/OpenABF/include/**

